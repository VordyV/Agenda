<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:c="clr-namespace:Agenda.Controls"
             x:Class="Agenda.Forms.AboutForm">
    <c:FormControl Height="400">
        <md:MarkdownRenderer Name="MarkdownContent"/>
    </c:FormControl>
    
</UserControl>
