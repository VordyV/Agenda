<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Agenda.Controls">
    <Design.PreviewWith>
        <controls:ProfileControl />
    </Design.PreviewWith>

    <Style Selector="controls|ProfileControl">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Classes="Hover" Theme="{StaticResource CardBorder}">
                    <Grid>
                        
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
