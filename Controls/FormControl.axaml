<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Agenda.Controls">
    <Design.PreviewWith>
        <controls:FormControl />
    </Design.PreviewWith>

    <Style Selector="controls|FormControl">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="12 10">
                    <Grid Width="400" RowDefinitions="*, Auto">
                        <StackPanel Grid.Row="0" Name="tt">
                            <TextBlock Text="{TemplateBinding Title}" Classes="H5" Theme="{StaticResource TitleTextBlock}" Margin="0 0 0 10"/>
                            <ContentPresenter Content="{TemplateBinding Content}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ContentPresenter Content="{TemplateBinding Footer}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
