<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:c="clr-namespace:Agenda.Controls"
             x:Class="Agenda.Modules.RconBF2142DefaultModule.Forms.KickForm">
    <c:FormControl Title="Kick a player from the server">
        <c:FormControl.Content>
            <StackPanel>
                <u:Form LabelPosition="Top" LabelWidth="*">
                    <AutoCompleteBox Name="AutoCompleteBoxReason" Width="400" Watermark="Reason"/>
                    <CheckBox Name="CheckBoxNop" Click="CheckBoxNop_OnClick" Content="Notify other players" IsChecked="True"/>
                </u:Form>
            </StackPanel>
        </c:FormControl.Content>
        <c:FormControl.Footer>
            <Button Name="ButtonKick" Click="ButtonKick_OnClick" HorizontalAlignment="Right" Content="Kick"/>
        </c:FormControl.Footer>
    </c:FormControl>
</UserControl>
