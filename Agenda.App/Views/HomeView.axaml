<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             xmlns:c="clr-namespace:Agenda.Controls"
             xmlns:l="clr-namespace:Agenda.Views"
             xmlns:u="https://irihi.tech/ursa"
             x:DataType="l:HomeView"
             x:Class="Agenda.Views.HomeView">
    <Grid RowDefinitions="Auto, Auto, *, Auto">
        <!-- HEADER -->
        <Grid ColumnDefinitions="Auto, *, Auto" Margin="24 24 24 0">
            <TextBlock Grid.Column="0" Classes="H3" Theme="{StaticResource TitleTextBlock}">My profiles</TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                <Button Name="ButtonNewSession" Click="ButtonNewSession_OnClick" Content="New session" Classes="Tertiary" Theme="{StaticResource OutlineButton}">
                    <ToolTip.Tip>Creates a new session based on the user data entered in the form</ToolTip.Tip>
                </Button>
                <Button Name="AddNewProfile" Click="AddNewProfile_OnClick" Content="Add new profile" Classes="Tertiary" Theme="{StaticResource SolidButton}"/>
            </StackPanel>
            
        </Grid>
        <TextBlock Grid.Row="1" Margin="24 0" >Saved connections and quick access to profiles</TextBlock>
        
        <!-- BODY -->
        <WrapPanel Grid.Row="2" Name="WrapPanelProfiles" Margin="24" ItemSpacing="24"/>
        <u:IconButton Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="12" Name="IconButtonRefresh" Click="IconButtonRefresh_OnClick" Icon="{StaticResource SemiIconRefresh}" Classes="Tertiary" Theme="{DynamicResource BorderlessIconButton}" />
        
        <!-- FOOTER -->
        <Grid Grid.Row="3" Margin="24">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Data="{StaticResource SemiIconServer}" Width="16" Height="16"/>
                <TextBlock>Stored profiles: </TextBlock>
                <TextBlock Name="TextBlockCount"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
