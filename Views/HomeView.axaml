<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             xmlns:c="clr-namespace:Agenda.Controls"
             xmlns:l="clr-namespace:Agenda.Views"
             xmlns:u="https://irihi.tech/ursa"
             x:DataType="l:HomeView"
             x:Class="Agenda.Views.HomeView">
    <Grid RowDefinitions="Auto, *">
        <!-- HEADER -->
        <Grid ColumnDefinitions="Auto, *, Auto" Margin="12 10">
            <TextBlock Grid.Column="0" Classes="H5" Theme="{StaticResource TitleTextBlock}">Profile list</TextBlock>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                <Button Name="ButtonNewSession" Click="ButtonNewSession_OnClick" Content="New session" Theme="{StaticResource OutlineButton}">
                    <ToolTip.Tip>Creates a new session based on the user data entered in the form</ToolTip.Tip>
                </Button>
                <Button Name="AddNewProfile" Click="AddNewProfile_OnClick" Content="Add new profile" Theme="{StaticResource SolidButton}"/>
            </StackPanel>
            
        </Grid>
        
        <!-- BODY -->
        <WrapPanel Grid.Row="1" Name="WrapPanelProfiles" Margin="24" ItemSpacing="24"/>
        <u:IconButton Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="12" Name="IconButtonRefresh" Click="IconButtonRefresh_OnClick" Icon="{StaticResource SemiIconRefresh}" Classes="Tertiary" Theme="{DynamicResource BorderlessIconButton}" />
    </Grid>
</UserControl>
